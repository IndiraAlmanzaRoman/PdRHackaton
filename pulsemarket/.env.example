# Copy to .env (local) and set the same variables in Vercel (production).

# PostgreSQL (Neon / Supabase). Use the pooled connection string on Vercel.
DATABASE_URL="postgresql://user:password@host:5432/pulsemarket?schema=public"

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Required only when running `next start` outside Vercel (e.g. CI / E2E).
# AUTH_TRUST_HOST="true"

# Google OAuth app. Callback: {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth app. Callback: {origin}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Test-only login used by Playwright. NEVER set these on Vercel production.
# E2E_TEST_MODE="true"
# E2E_TEST_SECRET="at-least-16-random-characters"
